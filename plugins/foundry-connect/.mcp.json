{
  "mcpServers": {
    "foundry": {
      "type": "http",
      "url": "https://${instance_host}/mcp"
    },
    "foundry-channel": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/channel/dist/channel.js"],
      "env": { "FOUNDRY_INSTANCE_HOST": "${user_config.instance_host}" }
    }
  }
}
